"""Variables de entorno del backend (plantilla).

Copiar a `.env` y rellenar. `.env` está en `.gitignore`: **ninguna credencial
del ROA ni clave puede quedar en el repositorio (RNF-16)**.
"""

# Proyecto de Firebase Cloud Messaging (FCM) que usa el backend para los avisos.
FIREBASE_PROJECT_ID=mi-proyecto-firebase

# Ruta al JSON de la cuenta de servicio con permiso para enviar por FCM.
# (No se commitea: apuntad a un fichero fuera del repo.)
GOOGLE_APPLICATION_CREDENTIALS=/ruta/al/service-account.json
